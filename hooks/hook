#!/usr/bin/env zshctl

source ${0:a:h}/config.zsh
source ${0:a:h}/schedule.zsh
source ${0:a:h}/complete.zsh

function :args {
    eval "$(args -b ,config -- "$@")"
}

function :execute {
    setopt localoptions noxtrace noverbose
    if (( o_config )); then
        config
        return
    fi

    if [[ $MARGINAL_DUMP_BINDING = 1 ]]; then
        # Debug output must not expose Secret data or embedded annotation values.
        jq '
            def identity: {apiVersion, kind, metadata: (.metadata | {name, namespace, uid, resourceVersion})};
            map({type, binding, watchEvent, object: (.object // {} | identity),
                objects: [.objects[]?.object | identity]})
        ' < "$BINDING_CONTEXT_PATH"
        return
    fi

    # Bare declarations print an existing value. Declare once, before the loops,
    # so a later event cannot print the previous complete Secret object.
    typeset binding_context entry btype binding obj object watch_event
    binding_context=$(< "$BINDING_CONTEXT_PATH")

    jq -c '.[]' <<< "$binding_context" | while IFS= read -r entry; do
        btype=$(jq -r '.type' <<< "$entry")
        binding=$(jq -r '.binding' <<< "$entry")

        case $btype in
            Synchronization)
                case $binding in
                    marginaljobs)
                        continue
                        ;;
                    marginal-managed-jobs)
                        #! Startup catch-up: any managed Job already Succeeded gets
                        #! its completion propagated now, closing the window where a
                        #! Job finished while the operator was down.
                        jq -c '.objects[]?.object // empty' <<< "$entry" | while IFS= read -r obj; do
                            record_completion --object "$(jq -c <<< "$obj")"
                        done
                        ;;
                    *)
                        jq -c '.objects[]?.object // empty' <<< "$entry" | while IFS= read -r obj; do
                            schedule --event-type added --object "$(jq -c <<< "$obj")" --listener "$binding"
                        done
                        ;;
                esac
                ;;
            Event)
                case $binding in
                    marginaljobs)
                        printf '%s\n' "marginal: MarginalJob change detected, restarting to reconfigure"
                        kill 1
                        return
                        ;;
                    marginal-managed-jobs)
                        object=$(jq -c '.object' <<< "$entry")
                        record_completion --object "$object"
                        ;;
                    *)
                        watch_event=$(jq -r '.watchEvent' <<< "$entry")
                        object=$(jq -c '.object' <<< "$entry")
                        schedule --event-type "${watch_event:l}" --object "$object" --listener "$binding"
                        ;;
                esac
                ;;
        esac
    done
}

# vim: ft=zsh :
